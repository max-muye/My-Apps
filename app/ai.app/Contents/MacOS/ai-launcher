#!/bin/zsh

set -u

APP_ROOT="$(cd "$(dirname "$0")/../Resources/app" && pwd)"
APP_URL="http://127.0.0.1:5173"
STATE_DIR="$HOME/Library/Application Support/AI App"
LOG_DIR="$HOME/Library/Logs/AI App"
PID_FILE="$STATE_DIR/server.pid"

mkdir -p "$STATE_DIR" "$LOG_DIR"

server_is_ready() {
  /usr/bin/curl --silent --fail --max-time 1 "$APP_URL" >/dev/null 2>&1
}

if [[ -f "$PID_FILE" ]]; then
  SERVER_PID="$(<"$PID_FILE")"
  if ! /bin/kill -0 "$SERVER_PID" >/dev/null 2>&1; then
    /bin/rm -f "$PID_FILE"
  fi
fi

if ! server_is_ready; then
  BUNDLED_NODE="$APP_ROOT/../bin/node"
  export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  if [[ -x "$BUNDLED_NODE" ]]; then
    NODE_BIN="$BUNDLED_NODE"
  else
    NODE_BIN="$(command -v node 2>/dev/null || true)"
  fi

  if [[ -z "$NODE_BIN" ]]; then
    /usr/bin/osascript -e 'display alert "AI could not start" message "Node.js is not installed or could not be found." as critical'
    exit 1
  fi

  cd "$APP_ROOT" || exit 1
  nohup "$NODE_BIN" server.js >>"$LOG_DIR/server.log" 2>&1 &
  echo $! >"$PID_FILE"

  for _ in {1..40}; do
    server_is_ready && break
    /bin/sleep 0.1
  done
fi

if server_is_ready; then
  /usr/bin/open "$APP_URL"
else
  /usr/bin/osascript -e 'display alert "AI could not start" message "The local server did not respond. See ~/Library/Logs/AI App/server.log for details." as critical'
  exit 1
fi
